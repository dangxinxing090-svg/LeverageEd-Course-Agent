# AI智能教育课程平台 环境变量配置
# 复制此文件为 .env 并填入你的 API Key
# 平台默认使用模拟模式运行，无需配置即可测试全部功能

# ============================================
# LLM Provider API Keys（可选）
# 配置后将使用真实大模型，否则使用模拟模式
# ============================================

# 智谱 GLM（国产推荐）
# ZHIPU_API_KEY=your-zhipu-api-key-here

# Kimi（Moonshot）
# KIMI_API_KEY=your-kimi-api-key-here

# 通义千问
# QWEN_API_KEY=your-qwen-api-key-here

# 豆包（字节跳动）
# DOUBAO_API_KEY=your-doubao-api-key-here

# DeepSeek
# DEEPSEEK_API_KEY=your-deepseek-api-key-here

# OpenAI
# OPENAI_API_KEY=your-openai-api-key-here

# ============================================
# 数据库配置（可选）
# 当前使用内存存储，无需配置
# ============================================

# PostgreSQL 数据库 URL
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_education

# Redis 缓存（用于限流）
# REDIS_URL=redis://localhost:6379/0

# ============================================
# 后端服务配置
# ============================================

# 服务端口（默认8000）
# PORT=8000

# 主机地址（默认0.0.0.0）
# HOST=0.0.0.0

# 调试模式（开发时建议开启）
# DEBUG=true

# ============================================
# 前端配置
# ============================================

# API 基础地址（开发时无需修改）
# REACT_APP_API_BASE_URL=http://localhost:8000
